# Firebase web app config (Project settings → Your apps → Web app).
# These identify the project to the client SDK and are safe to expose;
# access is controlled by Authentication → Settings → Authorized domains.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# The band's own Firebase (hardware readings). Leave unset to use a simulated band.
# Values the band sends as null/0 are simulated around that value's average.
NEXT_PUBLIC_HARDWARE_FIREBASE_API_KEY=
NEXT_PUBLIC_HARDWARE_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_HARDWARE_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_HARDWARE_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_HARDWARE_FIREBASE_APP_ID=
# Realtime Database path (e.g. /band), or a Firestore document (e.g. devices/band) when there's no database URL.
NEXT_PUBLIC_HARDWARE_FIREBASE_PATH=
